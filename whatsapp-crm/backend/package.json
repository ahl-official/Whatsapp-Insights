{
  "name": "whatsapp-crm-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop whatsapp-crm",
    "pm2:restart": "pm2 restart whatsapp-crm",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.js --update-env",
    "pm2:logs": "pm2 logs whatsapp-crm --lines 100"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "googleapis": "^140.0.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
