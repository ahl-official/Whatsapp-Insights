# ── WAHA ──────────────────────────────────────────
WAHA_BASE_URL=https://your-waha-server.com
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=your-session-name
WAHA_WEBHOOK_SECRET=your-random-secret-here

# Admin API (protects /run-insights, /run-sheets-sync, /status)
ADMIN_API_KEY=your-random-admin-key-here

# ── AI APIs ───────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
# Gemini model — use gemini-2.5-flash (gemini-1.5-flash may not be available on all keys)
GEMINI_MODEL=gemini-2.5-flash

# ── Supabase ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Google ────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_ID=your-google-sheet-id
# Use only the ID from the URL (between /d/ and /edit), not the full link
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── Feature Flags ─────────────────────────────────
# Set to "false" to disable without touching code
ENABLE_GOOGLE_SHEETS=true
ENABLE_GOOGLE_DRIVE_ARCHIVE=true
ENABLE_INSIGHTS_PIPELINE=true
ENABLE_DASHBOARD=true

# ── Server ────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Business Context (used in AI prompts) ─────────
BUSINESS_TYPE=sales
BUSINESS_LANGUAGE=hinglish
CLASSIFIER_MESSAGE_COUNT=8
INSIGHTS_BATCH_SIZE=50
MAX_TRANSCRIPT_CHARS=12000
INSIGHTS_CRON=0 */6 * * *
# Runs every Monday at 9:00 AM IST (= 3:30 AM UTC)
WEEKLY_SHEETS_CRON=30 3 * * 1
MONTHLY_ARCHIVE_CRON=0 3 1 * *

# Map WAHA session names to human-readable agent names
# Format: {"session_name": "Human Name", "session2": "Other Agent"}
# If a session is not in the map, the session name is used as fallback
AGENT_NAME_MAP={"ahlaiteam":"AHL Sales Team"}
